{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packwise.app/schemas/intelligence/api.schema.json",
  "title": "PackWise Intelligence API",
  "description": "Generated by scripts/build_intelligence_schemas.py. Do not edit by hand.",
  "$defs": {
    "APIError": {
      "type": "object",
      "required": [
        "error",
        "requestID"
      ],
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "requestID": {
          "type": "string"
        }
      }
    },
    "IntelligenceMeta": {
      "type": "object",
      "required": [
        "requestID",
        "generatedAt",
        "promptVersion",
        "schemaVersion"
      ],
      "properties": {
        "requestID": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "promptVersion": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "string"
        },
        "cached": {
          "type": "boolean"
        }
      }
    },
    "DestinationDTO": {
      "type": "object",
      "required": [
        "displayName",
        "countryCode"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "countryCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "TripContextDTO": {
      "type": "object",
      "required": [
        "destination",
        "startDate",
        "endDate",
        "tripType",
        "activities",
        "bagType",
        "packingStyle"
      ],
      "properties": {
        "destination": {
          "$ref": "#/$defs/DestinationDTO"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "durationDays": {
          "type": "integer",
          "minimum": 1
        },
        "tripType": {
          "enum": [
            "vacation",
            "cityBreak",
            "beach",
            "business",
            "outdoor",
            "roadTrip",
            "weddingEvent",
            "skiSnow",
            "festival",
            "visitingFamily",
            "other"
          ]
        },
        "activities": {
          "type": "array",
          "items": {
            "enum": [
              "beachDays",
              "boatTrip",
              "hiking",
              "museums",
              "niceDinner",
              "nightlife",
              "photography",
              "running",
              "shopping",
              "sightseeing",
              "snorkeling",
              "swimming",
              "walking",
              "wildlife",
              "work",
              "yoga"
            ]
          }
        },
        "contextChips": {
          "type": "array",
          "items": {
            "enum": [
              "bringingLaptop",
              "dailyMedication",
              "getColdEasily",
              "laundryAvailable",
              "needFormalOutfit",
              "runWhileTraveling",
              "travelingInternationally",
              "usuallyWorkOut",
              "wearContacts"
            ]
          }
        },
        "bagType": {
          "enum": [
            "personalItem",
            "carryOn",
            "checked",
            "backpack",
            "roadTripLuggage",
            "notSure"
          ]
        },
        "packingStyle": {
          "enum": [
            "light",
            "balanced",
            "prepared"
          ]
        },
        "transportation": {
          "enum": [
            "flight",
            "drive",
            "train",
            "cruise",
            "other",
            "unknown"
          ]
        },
        "laundryAccess": {
          "enum": [
            "none",
            "possible",
            "planned"
          ]
        },
        "travelerCount": {
          "type": "integer",
          "minimum": 1
        },
        "userNotes": {
          "type": "string",
          "maxLength": 2000
        },
        "weatherSummary": {
          "type": "string",
          "maxLength": 600
        },
        "currentItemIDs": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PackingItemDTO": {
      "type": "object",
      "required": [
        "displayName"
      ],
      "properties": {
        "canonicalItemID": {
          "type": "string"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 0
        },
        "category": {
          "type": "string"
        }
      }
    },
    "PackingSuggestionDTO": {
      "type": "object",
      "description": "reasonCode plus reasonArguments is the durable identifier PackWise renders from a localized template. reason is fallback prose.",
      "required": [
        "canonicalItemID",
        "action",
        "reasonCode"
      ],
      "properties": {
        "canonicalItemID": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "recommend",
            "remove_candidate",
            "quantity_change"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "signals": {
          "type": "array",
          "items": {
            "enum": [
              "weather",
              "duration",
              "activity",
              "tripType",
              "destination",
              "baseEssential",
              "userPreference",
              "history",
              "gptReasoning",
              "party"
            ]
          }
        },
        "reason": {
          "type": "string"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "reasonArguments": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "PackingOptimizationDTO": {
      "type": "object",
      "required": [
        "canonicalItemID",
        "reasonCode"
      ],
      "properties": {
        "canonicalItemID": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "reasonArguments": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "suggestedQuantity": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "InterpretTripRequest": {
      "type": "object",
      "required": [
        "note",
        "context",
        "safetyIdentifier"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "context": {
          "$ref": "#/$defs/TripContextDTO"
        },
        "safetyIdentifier": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      }
    },
    "InterpretTripResponse": {
      "type": "object",
      "required": [
        "meta",
        "inferredActivities",
        "inferredChips"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/IntelligenceMeta"
        },
        "inferredActivities": {
          "type": "array",
          "items": {
            "enum": [
              "beachDays",
              "boatTrip",
              "hiking",
              "museums",
              "niceDinner",
              "nightlife",
              "photography",
              "running",
              "shopping",
              "sightseeing",
              "snorkeling",
              "swimming",
              "walking",
              "wildlife",
              "work",
              "yoga"
            ]
          }
        },
        "inferredChips": {
          "type": "array",
          "items": {
            "enum": [
              "bringingLaptop",
              "dailyMedication",
              "getColdEasily",
              "laundryAvailable",
              "needFormalOutfit",
              "runWhileTraveling",
              "travelingInternationally",
              "usuallyWorkOut",
              "wearContacts"
            ]
          }
        },
        "noteSummary": {
          "type": "string"
        }
      }
    },
    "PackingGapsRequest": {
      "type": "object",
      "required": [
        "context",
        "items",
        "safetyIdentifier"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/TripContextDTO"
        },
        "items": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "$ref": "#/$defs/PackingItemDTO"
          }
        },
        "safetyIdentifier": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      }
    },
    "PackingGapResponse": {
      "type": "object",
      "required": [
        "meta",
        "suggestions"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/IntelligenceMeta"
        },
        "suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackingSuggestionDTO"
          }
        }
      }
    },
    "PackingOptimizeRequest": {
      "type": "object",
      "required": [
        "context",
        "items",
        "safetyIdentifier"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/TripContextDTO"
        },
        "items": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "$ref": "#/$defs/PackingItemDTO"
          }
        },
        "safetyIdentifier": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      }
    },
    "PackingOptimizationResponse": {
      "type": "object",
      "required": [
        "meta",
        "optimizations"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/IntelligenceMeta"
        },
        "optimizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackingOptimizationDTO"
          }
        }
      }
    }
  }
}
