# Copy to api/.env.local (gitignored) and fill in. Never commit real values.
#
# Step 1 of docs/m3a2-verification-runbook.md — live OpenAI smoke.
# This is the minimum: leave the store on memory and integrity on development,
# so the only new thing under test is the provider.

OPENAI_API_KEY=sk-...

# Required whenever OPENAI_API_KEY is set. The server HMACs the client's install
# token with this and sends only the digest as safety_identifier, so the raw
# token never reaches the provider. Any long random string works locally.
PACKWISE_SAFETY_IDENTIFIER_SECRET=

# Model routing. The var names the capability, not the endpoint.
PACKWISE_MODEL_CONTEXT=gpt-5.6
PACKWISE_MODEL_GAPS=gpt-5.6
PACKWISE_MODEL_OPTIMIZE=gpt-5.6

# --- Later steps. Leave unset for the OpenAI smoke. ---
#
# Step 2, real Redis. Setting this selects the Redis store. Any rediss:// or
# redis:// URL from Upstash or Redis Cloud works; there is no fallback to memory
# if it is unreachable.
# REDIS_URL=
#
# Steps 4 and 5, App Attest. All three are required together; the environment is
# never inferred. See the per-build table in the runbook.
# PACKWISE_INTEGRITY_MODE=appattest
# PACKWISE_APP_ID=<teamID>.com.packwise.app
# PACKWISE_APP_ATTEST_ENVIRONMENT=development
# PACKWISE_APP_ATTEST_ROOT_PEM=
#
# Step 3, production. Turns on every requirement above.
# PACKWISE_ENV=production
