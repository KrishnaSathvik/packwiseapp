{
  "name": "packwise-intelligence-api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 ../scripts/build_intelligence_schemas.py",
    "vercel-build": "node scripts/verify-artifact.ts && tsc --noEmit",
    "preflight": "python3 ../scripts/validate_shared.py && node scripts/verify-artifact.ts && tsc --noEmit && node --test test/*.test.ts",
    "dev": "npx --yes vercel dev",
    "serve": "node --env-file=.env.local scripts/serve.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/node": "^5.1.8",
    "ajv": "^8.20.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
